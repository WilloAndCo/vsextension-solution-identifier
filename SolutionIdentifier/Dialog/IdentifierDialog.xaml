<platformUI:DialogWindow x:Class="SolutionIdentifier.Dialog.IdentifierDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
                         xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
                         Title="Solution identifier"
                         SizeToContent="WidthAndHeight"
                         ResizeMode="NoResize"
                         ShowInTaskbar="False"
                         UseLayoutRounding="True"
                         Background="{DynamicResource {x:Static platformUI:ThemedDialogColors.WindowPanelBrushKey}}">
    <!-- Follows the Visual Studio theme the way Roslyn's dialogs do (dotnet/roslyn, VSThemeDictionary.xaml, MIT):
         each control type gets a style based on Visual Studio's themed dialog style for it.
         DynamicResource, so the colours change if the user switches theme while the dialog is open. -->
    <platformUI:DialogWindow.Resources>
        <!-- BasedOn must be a StaticResource; WPF does not allow DynamicResource there. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogButtonStyleKey}}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogTextBoxStyleKey}}">
            <!-- Taller than Visual Studio's own style. -->
            <Setter Property="Padding" Value="6,8,6,8" />
        </Style>
        <!-- Visual Studio has no themed dialog style for TextBlock, so Roslyn sets its colours directly. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- A colour or icon choice: a tile with a rounded ring, in place of the list box's full-width selection block.
             The ring is grey under the mouse or with keyboard focus, and the theme's highlight colour when chosen. -->
        <Style x:Key="ChoiceTileStyle" TargetType="ListBoxItem">
            <!-- The ring already shows keyboard focus. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Transparent, not unset, so the whole tile reacts to the mouse, not only its content. -->
                        <Border x:Name="Ring" Width="30" Height="30" CornerRadius="5" BorderThickness="2"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemGrayTextBrushKey}}" />
                            </Trigger>
                            <!-- Last, so a chosen tile keeps its highlight under the mouse: later triggers win. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.SystemHighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of choice tiles on the dialog background. Still a ListBox, so keyboard arrows and UI Automation
             (which the UI tests use to choose) work as before. -->
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Static vsshell:VsResourceKeys.ThemedDialogListBoxStyleKey}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceTileStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </platformUI:DialogWindow.Resources>

    <StackPanel Margin="16" Width="400">
        <TextBlock Text="Title:" Margin="0,0,0,4" />
        <!-- AutomationIds: what the UI tests use to find the controls. -->
        <TextBox x:Name="TitleTextBox" AutomationProperties.AutomationId="TitleTextBox" />
        <TextBlock x:Name="EmptyTitleHint" Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" />

        <TextBlock Text="Colour:" Margin="0,14,0,4" />
        <ListBox x:Name="ColourChoices" />

        <TextBlock Text="Icon:" Margin="0,10,0,4" />
        <ListBox x:Name="IconChoices" />

        <TextBlock x:Name="ChoiceErrorText" Foreground="{DynamicResource {x:Static platformUI:ThemedDialogColors.ValidationErrorTextBrushKey}}" Visibility="Collapsed" Margin="0,8,0,0" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Reset" AutomationProperties.AutomationId="ResetButton" MinWidth="75" Click="ChooseResetAndCloseDialog"
                    ToolTip="Close this dialog and remove this solution's saved identifier. The menu bar goes back to the solution's path, with the colour and icon picked from it." />
            <Button Grid.Column="1" Content="Options..." AutomationProperties.AutomationId="OptionsButton" MinWidth="75" Margin="8,0,0,0" Click="ChooseOpenOptionsAndCloseDialog"
                    ToolTip="Close this dialog without saving and open Tools > Options > Solution Identifier." />
            <Button Grid.Column="3" Content="OK" AutomationProperties.AutomationId="OkButton" IsDefault="True" MinWidth="75" Click="ChooseSaveAndCloseIfChoicesComplete" />
            <Button Grid.Column="4" Content="Cancel" AutomationProperties.AutomationId="CancelButton" IsCancel="True" MinWidth="75" Margin="8,0,0,0" />
        </Grid>
    </StackPanel>
</platformUI:DialogWindow>
