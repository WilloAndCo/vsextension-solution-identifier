<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="vsshlids.h" />

	<Commands package="guidSolutionIdentifierPackage">

		<Menus>
			<!--
			IDG_VS_MM_WINDOWHELP is the "window and help" section of the Menu Bar
			Priority being last puts this at the far right side of the menu bar group
			TextIsAnchorCommand shows the last command text and icon
			DynamicVisibility it can be hidden when not needed
			-->
			<Menu guid="guidExtensionCmdSet" id="MenuBarSplitButton" priority="0xFFFF" type="MenuControllerLatched">
				<Parent guid="guidSHLMainMenu" id="IDG_VS_MM_WINDOWHELP" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<CommandFlag>IconAndText</CommandFlag>
				<CommandFlag>TextChanges</CommandFlag>
				<CommandFlag>TextIsAnchorCommand</CommandFlag>
				<Strings>
					<ButtonText>My Solution Identifier</ButtonText>
				</Strings>
			</Menu>
		</Menus>

		<Groups>
			<Group guid="guidExtensionCmdSet" id="ChangeIdentifierGroup" priority="0x0100">
				<Parent guid="guidExtensionCmdSet" id="MenuBarSplitButton" />
			</Group>
			<Group guid="guidExtensionCmdSet" id="ColourAndShapeButtonsGroup" priority="0x0200">
				<Parent guid="guidExtensionCmdSet" id="MenuBarSplitButton" />
			</Group>
		</Groups>

		<Buttons>
			<!--
			TextChanges so the buttons text can change at run time.
			NoShowOnMenuController stops the button from showing in the drop down menu even if it is set to visible for the Split Button
			-->
			<Button guid="guidExtensionCmdSet" id="RoseSquareButton" priority="0x0200" type="Button">
				<Parent guid="guidExtensionCmdSet" id="ColourAndShapeButtonsGroup" />
				<Icon guid="guidIdentifierIcons" id="bmpRoseSquare" />
				<CommandFlag>DynamicVisibility</CommandFlag>
				<CommandFlag>DefaultInvisible</CommandFlag>
				<CommandFlag>IconAndText</CommandFlag>
				<CommandFlag>TextChanges</CommandFlag>
				<CommandFlag>NoShowOnMenuController</CommandFlag>
